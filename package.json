  "description": "Enterprise Blood Bank Management System & PostgreSQL REST API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node database/migrate.js",
    "db:init": "node database/migrate.js",
    "db:seed": "node database/reset_and_seed.js",
